# Base de données PostgreSQL + PostGIS (Neon, avec sslmode=require ; en local : npm run db:up)
DATABASE_URL=

# Session : secret des sessions et des codes de connexion (openssl rand -base64 48)
SESSION_SECRET=

# Domaine public, sans https:// (Traefik / Caddy, QR codes)
SITE_DOMAIN=
# Adresse complète si elle diffère de https://SITE_DOMAIN (ex. http://localhost:3000 en local)
SITE_URL=

# Numéro WhatsApp de l'équipe, ex. 221771234567
WHATSAPP_NUMBER=

# Démonstration
DEMO_MODE=true
SMS_PROVIDER=demo

# Variante Caddy uniquement
#COMPOSE_FILE=docker-compose.caddy.yml
#ACME_EMAIL=
